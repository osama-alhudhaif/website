<mjml>
  <mj-head>
    <mj-title>مرحباً بك في Oda</mj-title>
    <mj-font name="Arial" href="https://fonts.googleapis.com/css?family=Arial" />
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#51545E" line-height="1.6" align="right" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F2F4F6">
    <mj-section padding="20px 0">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#333333">
          Oda | أودا
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="8px" padding="40px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#333333">
          {{ title }}
        </mj-text>
        <mj-text>
          {{ greeting }}
        </mj-text>
        <mj-text>
          {{ body }}
        </mj-text>
        
        <mj-spacer height="20px" />
        
        <mj-button background-color="#3869D4" color="#ffffff" font-size="16px" font-weight="bold" border-radius="5px" href="{{ action_url }}" width="100%">
          {{ button }}
        </mj-button>
        
        <mj-spacer height="20px" />
        
        <mj-text font-size="14px">
          {{ signature }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#A8AAAF">
          © 2026 Oda Platform. جميع الحقوق محفوظة.
          <br />
          القصيم، المملكة العربية السعودية
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>