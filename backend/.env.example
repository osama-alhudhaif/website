# ملف المثال لمتغيرات البيئة - لا تضع قيماً حقيقية هنا
# انسخ هذا الملف إلى .env وعدّل القيم

# --- إعدادات قاعدة البيانات ---
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- الأمان ---
# أنشئ مفتاحاً سرياً قوياً باستخدام: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
# ضع False في بيئة الإنتاج دائماً
DEBUG=False
DJANGO_ENV=development

# --- المضيفون المسموح بهم ---
ALLOWED_HOSTS=127.0.0.1,localhost

# --- رابط الواجهة الأمامية ---
FRONTEND_URL=http://localhost:5173

# --- إعدادات CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- إعدادات البريد الإلكتروني ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=Oda <no-reply@oda.com>
ODA_SUPPORT_EMAIL=support@oda.com
