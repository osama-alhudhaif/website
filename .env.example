# Django Backend Environment Variables

# Security Settings
SECRET_KEY = your-secret-key-here-change-in-production
DEBUG = False
ALLOWED_HOSTS = your-domain.railway.app, localhost, 127.0.0.1
ADMIN_URL = admin/

# Database Configuration (PostgreSQL)
DB_NAME = oda_db
DB_USER = postgres
DB_PASSWORD = your-db-password-here
DB_HOST = postgres.railway.internal
DB_PORT = 5432

# Frontend API Configuration
VITE_API_BASE_URL = https://your-backend-domain.railway.app/api/v1
FRONTEND_URL = https://your-frontend-domain.railway.app
CORS_ALLOWED_ORIGINS = https://your-frontend-domain.railway.app

# Email Configuration (if needed)
EMAIL_BACKEND = django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST = smtp.gmail.com
EMAIL_PORT = 587
EMAIL_USE_TLS = True
EMAIL_HOST_USER = your-email@gmail.com
EMAIL_HOST_PASSWORD = your-app-password
DEFAULT_FROM_EMAIL = Oda <no-reply@oda.com>
ODA_SUPPORT_EMAIL = support@oda.com

# Optional: Redis/Caching (if needed)
REDIS_URL = redis://default:password@redis.railway.internal:6379
